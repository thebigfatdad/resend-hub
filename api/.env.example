# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
GCS_BUCKET_NAME=your-bucket-name
CLOUD_TASKS_QUEUE=projects/your-project/locations/us-central1/queues/support-hub-ai
CLOUD_RUN_SERVICE_URL=https://your-service-url.run.app

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Per-brand webhook secrets (env var name comes from brand.resend.webhookSecretRef)
# Copy the whsec_… value from Resend dashboard → Webhooks → signing secret for each brand
RESEND_WEBHOOK_SECRET_PERSONIQ=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SECRET_WHOSCALLING=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SECRET_TRUSTMATCH=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App settings
APP_ENV=development
LOG_LEVEL=INFO
